rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // One replaceable document per user. History and image files remain in
    // Supabase; the Firebase client cannot create an event history.
    match /users/{userId}/state/latest_action {
      allow read, create, update: if ownsUser(userId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
